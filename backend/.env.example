DATABASE_URL=sqlite+aiosqlite:///../db/wallpapers.db

# API Key for remote authentication. If empty, authentication is disabled.
# To generate a secure random 32-byte key, run:
# python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Set to true to enable read-only sandbox mode and slowapi rate limiting for public web demos
DEMO_MODE=false

# Allowed CORS origins (comma-separated or wildcard '*')
CORS_ORIGINS=*

